# Supabase project credentials (client-side, injected at build time by Vite).
# Copy this file to `.env` and fill in the values from your Supabase project
# settings → API. The anon/publishable key is safe to expose in the client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your-anon-publishable-key
